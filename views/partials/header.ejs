<header class="flex items-center justify-between h-20 px-6 bg-white border-b border-gray-200 shadow-sm">
    <button @click="sidebarOpen = !sidebarOpen" class="text-gray-500 focus:outline-none lg:hidden">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
    </button>

    <div class="font-bold hidden text-xl md:text-xl sm:block">
        Sistem Ticketing
    </div>

    <div class="relative" x-data="{ dropdownOpen: false }">
        <button @click="dropdownOpen = !dropdownOpen" class="flex items-center space-x-3 focus:outline-none">
            <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold overflow-hidden">
                <% if (user.profile_picture) { %>
                    <img src="/uploads/profile/<%= user.profile_picture %>" alt="Avatar" class="w-full h-full object-cover">
                <% } else { %>
                    <span><%= user.name.charAt(0).toUpperCase() %></span>
                <% } %>
            </div>
            <span id="userNameDisplay" class="text-sm font-medium text-gray-700 text-left hidden md:block"><%= user.name %></span>
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>

        <div x-show="dropdownOpen" x-cloak @click.away="dropdownOpen = false" 
            class="absolute right-0 mt-2 w-48 bg-white border border-gray-200 rounded-lg shadow-lg py-1 z-50">
            <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-xs text-gray-500">Cabang: <span class="font-medium text-gray-700"><%= user.branch_name || 'Pusat' %></span></p>
                <p class="text-xs text-gray-500 mt-0.5">Unit: <span class="font-medium text-gray-700"><%= user.unit_name || 'Manajemen' %></span></p>
            </div>
            <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">Profil Saya</a>
            <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-100 transition">Keluar (Logout)</a>
        </div>
    </div>
</header>