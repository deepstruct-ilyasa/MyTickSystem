<div class="space-y-6" x-data="Object.assign(userManagement(), { search: '' })">

    <!-- Header Page & Kolom Pencarian -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Manajemen User</h1>
            <p class="text-sm text-gray-500 mt-1">Kelola data pegawai, role, dan hierarki atasan.</p>
        </div>
        
        <div class="flex items-center gap-3 w-full sm:w-auto flex-wrap">
            <!-- Kolom Input Search -->
            <div class="relative w-full sm:w-64">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </span>
                <input type="text" x-model="search" placeholder="Cari..." class="w-full pl-9 pr-4 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none shadow-sm">
            </div>

            <div class="flex items-center gap-2" x-data="{ openImportModal: false }">
                <% if (['superadmin', 'admin_cabang'].includes(user.role)) { %>
                    <!-- ⭐ Tombol Membuka Modal Import Excel ⭐ -->
                    <button @click="openImportModal = true" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-lg transition shadow-sm text-sm whitespace-nowrap flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                        Import Excel
                    </button>
                <% } %>

                <% if (['superadmin', 'admin_cabang', 'manager', 'supervisor'].includes(user.role)) { %>
                    <button @click="openModalAdd()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition shadow-sm text-sm whitespace-nowrap">
                        + Tambah User
                    </button>
                <% } %>

                <!-- ================= MODAL BULK IMPORT USER ================= -->
                <div x-show="openImportModal" x-cloak class="fixed inset-0 z-50 bg-gray-950/80 backdrop-blur-sm flex items-center justify-center p-4" style="display: none;">
                    <div @click.away="openImportModal = false" class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-6 md:p-8 space-y-6 border border-gray-100 text-left" x-data="userImportHandler()">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                            <h3 class="text-lg font-bold text-gray-900">Bulk Import Data User</h3>
                            <button type="button" @click="openImportModal = false" class="p-2 text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>

                        <div class="space-y-4">
                            <p class="text-xs text-gray-500 leading-relaxed">
                                Unggah file spreadsheet berformat <b class="text-gray-700">.xlsx</b> atau <b class="text-gray-700">.csv</b>.
                            </p>

                            <!-- ⭐ TAMBAHAN: DROPDOWN CABANG KHUSUS SUPERADMIN ⭐ -->
                            <% if (user.role === 'superadmin') { %>
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Pilih Cabang Target</label>
                                    <select x-model="importBranchId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                        <option value="">-- Pilih Cabang --</option>
                                        <% branches.forEach(b => { %>
                                            <option value="<%= b.id %>"><%= b.name %></option>
                                        <% }) %>
                                    </select>
                                    <p class="text-[10px] text-gray-400 mt-1">*Wajib memilih cabang sebelum download template atau import.</p>
                                </div>
                            <% } %>

                            <!-- Tombol Download Template (Dinamic HREF via Alpine) -->
                            <div>
                                <a :href="('<%= user.role %>' === 'superadmin') ? (importBranchId ? '/users/template?branch_id=' + importBranchId : '#') : '/users/template'" 
                                @click="if('<%= user.role %>' === 'superadmin' && !importBranchId) { $event.preventDefault(); Swal.fire('Oops!', 'Pilih cabang terlebih dahulu untuk mengunduh template.', 'warning'); }"
                                class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-2 rounded-xl transition w-full justify-center border border-blue-100">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                    Download Template Excel User
                                </a>
                            </div>

                            <!-- Form Upload -->
                            <form @submit.prevent="submitImport" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Pilih File Excel / CSV</label>
                                    <input type="file" x-ref="importFile" accept=".xlsx, .xls, .csv" required class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer border border-gray-200 rounded-xl p-1">
                                </div>

                                <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                                    <button type="button" @click="openImportModal = false" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-semibold transition">
                                        Batal
                                    </button>
                                    <button type="submit" :disabled="loading" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold shadow-sm transition flex items-center gap-2">
                                        <span x-show="loading" class="animate-spin">⏳</span>
                                        <span x-text="loading ? 'Mengimpor...' : 'Proses Import'"></span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Notifikasi -->
    <% if (locals.success) { %>
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg text-sm"><%= success %></div>
    <% } %>
    <% if (locals.error) { %>
        <div class="p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm"><%= error %></div>
    <% } %>

    <!-- Tabel Data User dengan Support Responsive & Live Search -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[700px]">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <th class="px-6 py-4 text-center">NIP</th>
                        <th class="px-6 py-4 text-center">Nama</th>
                        <th class="px-6 py-4 text-center">Role</th>
                        <th class="px-6 py-4 text-center">Unit</th>
                        <th class="px-6 py-4 text-center">Atasan</th>
                        <% if (user.role === 'superadmin') { %>
                            <th class="px-6 py-4 text-center">Cabang</th>
                        <% } %>
                        <th class="px-6 py-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 text-sm text-gray-700 text-center">
                    <% if (usersList.length === 0) { %>
                        <tr><td colspan="7" class="px-6 py-4 text-center text-gray-400">Belum ada data user yang dapat ditampilkan.</td></tr>
                    <% } else { %>
                        <% usersList.forEach(u => { %>
                            <!-- Baris tabel difilter secara reaktif berdasarkan nama atau NIP -->
                            <tr class="hover:bg-gray-50 transition"
                                x-show="search === '' || [
                                    '<%= u.nip %>', 
                                    '<%= u.name %>', 
                                    '<%= u.role %>', 
                                    '<%= u.unit_name || '' %>', 
                                    '<%= u.supervisor_name || '' %>', 
                                    '<%= u.branch_name %>'
                                ].some(val => val.toLowerCase().includes(search.toLowerCase()))">
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-gray-800"><%= u.nip %></p>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-gray-800"><%= u.name %></p>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 text-xs font-bold uppercase rounded-full 
                                        <%= u.role === 'superadmin' ? 'bg-red-100 text-red-700' : 
                                        (u.role === 'manager' ? 'bg-purple-100 text-purple-700' : 
                                        (u.role === 'supervisor' ? 'bg-amber-100 text-amber-700' : 'bg-gray-100 text-gray-700')) %>">
                                        <%= u.role.replace('_', ' ') %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="font-semibold text-gray-800"><%= u.unit_name || '-' %></p>
                                </td>
                                <td class="px-6 py-4 font-semibold text-gray-800"><%= u.supervisor_name || '-' %></td>
                                <% if (user.role === 'superadmin') { %>
                                    <td class="px-6 py-4 font-semibold text-gray-800"><%= u.branch_name %></td>
                                <% } %>
                                <td class="px-6 py-4 text-center space-x-2 whitespace-nowrap">
                                    <% if (['superadmin', 'admin_cabang', 'manager', 'supervisor'].includes(user.role) && u.role !== 'superadmin') { %>
                                        <!-- Tombol Edit Profil -->
                                        <button @click='editUser(<%= JSON.stringify(u) %>)' class="text-blue-600 hover:underline font-semibold">Edit</button>
                                        
                                        <!-- ⭐ Tombol Reset Password dengan SweetAlert2 ⭐ -->
                                        <% if (['superadmin', 'admin_cabang'].includes(user.role)) { %>
                                            <button type="button" @click="confirmReset('<%= u.id %>', '<%= u.name %>')" class="text-amber-600 hover:underline font-semibold">Reset</button>
                                        <% } %>

                                        <!-- ⭐ Tombol Hapus dengan SweetAlert2 ⭐ -->
                                        <button type="button" @click="confirmDelete('<%= u.id %>', '<%= u.name %>')" class="text-red-600 hover:underline font-semibold">Hapus</button>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Form (Digunakan untuk Tambah & Edit Sekaligus) -->
    <div x-show="openAddModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" style="display: none;">
        <div @click.away="openAddModal = false" class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 space-y-4 max-h-[90vh] overflow-y-auto">
            <h3 class="text-lg font-bold text-gray-800" x-text="isEditMode ? 'Edit User' : 'Tambah User Baru'"></h3>
            
            <form :action="isEditMode ? '/users/update/' + editId : '/users/create'" method="POST" class="space-y-4">
                
                <!-- Pilih Cabang -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Cabang</label>
                    <select name="branch_id" x-model="selectedBranch" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Cabang --</option>
                        <% branches.forEach(b => { %>
                            <option value="<%= b.id %>"><%= b.name %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Pilih Role -->
                <div x-show="selectedBranch !== ''" style="display: none;">
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Jabatan</label>
                    <select name="role" x-model="selectedRole" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Role --</option>
                        <% if (['superadmin', 'admin_cabang'].includes(user.role)) { %>
                            <option value="manager">Manager</option>
                            <option value="admin_cabang" x-show="'<%= user.role %>' === 'superadmin'">Admin Cabang</option>
                        <% } %>
                        <% if (['superadmin', 'admin_cabang', 'manager'].includes(user.role)) { %>
                            <option value="supervisor">Supervisor</option>
                        <% } %>
                        <option value="staf">Staf</option>
                    </select>
                </div>

                <!-- Pilih Unit -->
                <div x-show="selectedRole !== '' && selectedRole !== 'admin_cabang'" style="display: none;">
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Pilih Unit</label>
                    <select name="unit_id" x-model="selectedUnit" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Unit --</option>
                        <template x-for="unit in filteredUnits" :key="unit.id">
                            <option :value="unit.id" x-text="unit.name"></option>
                        </template>
                    </select>
                </div>

                <!-- Pilih Atasan -->
                <div x-show="['supervisor', 'staf'].includes(selectedRole)" style="display: none;">
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Atasan</label>
                    <select name="supervisor_id" x-model="selectedSuperior" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Atasan --</option>
                        <template x-for="sup in filteredSuperiors" :key="sup.id">
                            <option :value="sup.id" x-text="sup.name + ' (' + sup.role.toUpperCase() + ')'"></option>
                        </template>
                    </select>
                </div>

                <hr class="border-gray-200">

                <!-- Data Pribadi -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">NIP</label>
                        <input type="text" name="nip" x-model="inputNip" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                    
                    <div x-show="!isEditMode">
                        <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Password</label>
                        <input type="password" name="password" :required="!isEditMode" placeholder="Password awal" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Nama Lengkap</label>
                    <input type="text" name="name" x-model="inputName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                </div>

                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" @click="openAddModal = false" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium">Batal</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Script Alpine.js & Handler AJAX Import User -->
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('userManagement', () => ({
            openAddModal: false,
            isEditMode: false,
            editId: null,
            
            allUnits: <%- unitsJSON %>,
            allSuperiors: <%- superiorsJSON %>,
            allBranches: <%- JSON.stringify(branches) %>,
            
            selectedBranch: '',
            selectedRole: '',
            selectedUnit: '',
            selectedSuperior: '',
            inputNip: '',
            inputName: '',

            init() {
                this.$watch('openAddModal', (val) => {
                    if (val && !this.isEditMode) {
                        let branchOptions = document.querySelectorAll('select[name="branch_id"] option');
                        let validBranches = Array.from(branchOptions).filter(opt => opt.value !== "");
                        if (validBranches.length === 1) {
                            this.selectedBranch = validBranches[0].value;
                        }
                    }
                });

                this.$watch('selectedRole', (newRole) => {
                    if (!this.isEditMode && newRole !== '') {
                        this.$nextTick(() => {
                            if (this.filteredUnits.length === 1) {
                                this.selectedUnit = String(this.filteredUnits[0].id);
                            } else {
                                this.selectedUnit = '';
                            }
                        });
                    } else if (!this.isEditMode) {
                        this.selectedUnit = '';
                        this.selectedSuperior = '';
                    }
                });

                this.$watch('filteredUnits', (newUnits) => {
                    if (!this.isEditMode && newUnits.length === 1) {
                        this.selectedUnit = String(newUnits[0].id);
                    }
                });

                this.$watch('filteredSuperiors', (newSups) => {
                    if (!this.isEditMode && newSups.length === 1) {
                        this.selectedSuperior = String(newSups[0].id);
                    }
                });
            },

            openModalAdd() {
                this.isEditMode = false;
                this.editId = null;
                this.selectedBranch = '';
                this.selectedRole = '';
                this.selectedUnit = '';
                this.selectedSuperior = '';
                this.inputNip = '';
                this.inputName = '';
                this.openAddModal = true;
            },

            editUser(u) {
                this.isEditMode = true;
                this.editId = u.id;
                this.inputNip = u.nip ? String(u.nip) : '';
                this.inputName = u.name ? String(u.name) : '';
                
                this.selectedBranch = u.branch_id !== null && u.branch_id !== undefined ? String(u.branch_id) : '';
                this.selectedRole = u.role ? String(u.role) : '';
                
                this.openAddModal = true;
                
                this.$nextTick(() => {
                    this.selectedUnit = u.unit_id !== null && u.unit_id !== undefined ? String(u.unit_id) : '';
                    this.$nextTick(() => {
                        this.selectedSuperior = u.supervisor_id !== null && u.supervisor_id !== undefined ? String(u.supervisor_id) : '';
                    });
                });
            },
            
            get filteredUnits() {
                let unitsInBranch = this.allUnits.filter(u => u.branch_id == this.selectedBranch);
                if (this.selectedRole === 'manager') {
                    return unitsInBranch.filter(u => u.parent_unit_id === null);
                }
                if (this.selectedRole === 'supervisor' || this.selectedRole === 'staf') {
                    return unitsInBranch.filter(u => u.parent_unit_id !== null);
                }
                return unitsInBranch;
            },
            
            get filteredSuperiors() {
                if (this.selectedRole === 'supervisor') {
                    let currentUnit = this.allUnits.find(u => u.id == this.selectedUnit);
                    if (!currentUnit || !currentUnit.parent_unit_id) return [];
                    return this.allSuperiors.filter(s => s.role === 'manager' && s.unit_id == currentUnit.parent_unit_id);
                }
                if (this.selectedRole === 'staf') {
                    return this.allSuperiors.filter(s => s.role === 'supervisor' && String(s.unit_id) === String(this.selectedUnit));
                }
                return [];
            },

            // ⭐ SweetAlert Konfirmasi Reset Password ⭐
            confirmReset(id, name) {
                Swal.fire({
                    title: 'Reset Password?',
                    text: `Apakah Anda yakin ingin mereset password user "${name}" menjadi "123456"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d97706',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Ya, Reset!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/users/reset-password/${id}`;
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            },

            // ⭐ SweetAlert Konfirmasi Hapus User ⭐
            confirmDelete(id, name) {
                Swal.fire({
                    title: 'Hapus User?',
                    text: `Apakah Anda yakin ingin menghapus data user "${name}"? Tindakan ini tidak dapat dibatalkan.`,
                    icon: 'error',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Ya, Hapus!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/users/delete/${id}`;
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            }
        }));
    });

    // Handler khusus untuk Modal Upload Excel User via AJAX
    function userImportHandler() {
        return {
            loading: false,
            importBranchId: '', // Menyimpan state pilihan cabang superadmin
            async submitImport() {
                // Validasi Superadmin
                if ('<%= user.role %>' === 'superadmin' && !this.importBranchId) {
                    Swal.fire('Peringatan', 'Superadmin wajib memilih cabang target terlebih dahulu!', 'warning');
                    return;
                }

                const fileInput = this.$refs.importFile;
                if (!fileInput.files.length) {
                    Swal.fire('Peringatan', 'Silakan pilih file terlebih dahulu.', 'warning');
                    return;
                }

                const formData = new FormData();
                formData.append('file', fileInput.files[0]);
                
                // ⭐ Sisipkan branch_id ke dalam form data jika superadmin
                if ('<%= user.role %>' === 'superadmin') {
                    formData.append('branch_id', this.importBranchId);
                }

                this.loading = true;
                try {
                    const response = await fetch('/users/import', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();

                    if (response.ok && result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Berhasil!',
                            text: result.message,
                            confirmButtonColor: '#2563eb'
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Gagal Import',
                            text: result.message || 'Terjadi kesalahan saat memproses data user.',
                            confirmButtonColor: '#dc2626'
                        });
                    }
                } catch (err) {
                    console.error(err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Kesalahan Server',
                        text: 'Gagal terhubung ke server.',
                        confirmButtonColor: '#dc2626'
                    });
                } finally {
                    this.loading = false;
                }
            }
        }
    }
</script>