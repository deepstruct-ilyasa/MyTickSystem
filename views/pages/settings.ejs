<div class="max-w-4xl mx-auto py-1 px-2 sm:px-1 lg:px-1">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-4 md:p-4">
        
        <!-- Header Halaman -->
        <div class="mb-8 border-b border-gray-100 pb-2">
            <h1 class="text-2xl font-bold text-gray-800">Pengaturan Sistem</h1>
        </div>

        <!-- Peringatan HTTPS untuk Hybrid -->
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-start space-x-3 text-amber-800">
            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <div class="text-xs space-y-1">
                <span class="font-bold block text-amber-900">Catatan Penting Keamanan HTTPS:</span>
                <p>Fitur PWA <strong>wajib menggunakan protokol HTTPS</strong> pada kedua URL (Utama maupun Cadangan). Pastikan server lokal atau cadangan Anda sudah memiliki sertifikat SSL yang valid agar browser tidak memblokir koneksi.</p>
            </div>
        </div>

        <form action="/settings" method="POST" class="space-y-6">
            
            <!-- Toggle PWA Enabled -->
            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
                <div>
                    <label class="block text-sm font-bold text-gray-800">Aktifkan Fitur PWA</label>
                    <p class="text-xs text-gray-500 mt-0.5">Memungkinkan aplikasi di-install ke perangkat.</p>
                </div>
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" name="pwa_enabled" value="true" <%= settings.PWA_ENABLED === 'true' ? 'checked' : '' %> class="sr-only peer">
                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                </label>
            </div>

            <!-- Pilihan Mode PWA -->
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Mode Operasional PWA <span class="text-red-500">*</span></label>
                <select name="pwa_mode" id="pwaModeSelect" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                    <option value="main" <%= settings.PWA_MODE === 'main' ? 'selected' : '' %>>Main Access</option>
                    <option value="redundant" <%= settings.PWA_MODE === 'redundant' ? 'selected' : '' %>>Redundant Access</option>
                </select>
                <p class="text-xs text-gray-400 mt-1">Mode Redundant memungkinkan peralihan otomatis ke URL cadangan ber-HTTPS jika URL utama gagal merespons.</p>
            </div>

            <!-- Main URL -->
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Main URL<span class="text-red-500">*</span></label>
                <input type="text" name="main_url" value="<%= settings.MAIN_URL %>" required 
                       placeholder="Contoh: https://myticksystem.com" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
            </div>

            <!-- Secondary URL (Muncul jika redundant dipilih) -->
            <div id="secondaryUrlGroup" style="display: <%= settings.PWA_MODE === 'redundant' ? 'block' : 'none' %>;">
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Secondary URL</label>
                <input type="text" name="secondary_url" value="<%= settings.SECONDARY_URL || '' %>" 
                       placeholder="Contoh: https://lokal.myticksystem.local atau https://172.100.25.172" 
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none transition">
                <p class="text-xs text-gray-400 mt-1">Alamat server cadangan ber-HTTPS yang dituju jika jalur utama gagal merespons.</p>
            </div>

            <!-- Tombol Aksi -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end space-x-3">
                <a href="/dashboard" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-semibold transition">Batal</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm shadow-sm transition">
                    Simpan Pengaturan
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('pwaModeSelect').addEventListener('change', function() {
        const secondaryGroup = document.getElementById('secondaryUrlGroup');
        if (this.value === 'redundant') {
            secondaryGroup.style.display = 'block';
        } else {
            secondaryGroup.style.display = 'none';
        }
    });
</script>