<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8" x-data="profilePreview()">
    <h2 class="text-xl font-bold text-gray-800 mb-1">Profil Saya</h2>
    <p class="text-sm text-gray-500 mb-6">Kelola informasi akun dan ubah password mandiri Anda di sini.</p>

    <!-- Notifikasi Alert -->
    <% if (error) { %>
        <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 text-sm rounded-r-lg"><%= error %></div>
    <% } %>
    <% if (success) { %>
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 text-sm rounded-r-lg"><%= success %></div>
    <% } %>

    <form action="/profile/update" method="POST" enctype="multipart/form-data" class="space-y-4">
        
        <!-- Bagian Foto Profil dengan Live Preview -->
        <div class="flex items-center space-x-4 mb-4">
            <!-- Lingkaran Avatar -->
            <div class="w-16 h-16 rounded-full overflow-hidden bg-blue-600 text-white flex items-center justify-center font-bold text-xl border border-gray-300 shrink-0">
                
                <!-- 1. Munculkan gambar jika ada preview baru ATAU sudah ada foto profil di database -->
                <template x-if="imageUrl">
                    <img :src="imageUrl" alt="Preview Foto" class="w-full h-full object-cover">
                </template>

                <template x-if="!imageUrl">
                    <% if (profileUser.profile_picture) { %>
                        <img src="/uploads/profile/<%= profileUser.profile_picture %>" alt="Foto Profil" class="w-full h-full object-cover">
                    <% } else { %>
                        <!-- Fallback teks inisial langsung dirender di sini agar pasti muncul -->
                        <span><%= profileUser.name.charAt(0).toUpperCase() %></span>
                    <% } %>
                </template>

            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Ganti Foto Profil</label>
                <input type="file" name="profile_picture" accept="image/*" @change="fileChosen" class="text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                <p class="text-xs text-gray-400 mt-1">Format: JPG, PNG, atau WEBP (Maks. 2MB)</p>
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">NIP</label>
            <input type="text" value="<%= profileUser.nip %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Cabang</label>
                <input type="text" value="<%= profileUser.branch_name || '-' %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Unit Kerja</label>
                <input type="text" value="<%= profileUser.unit_name || '-' %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Nama Lengkap</label>
            <input type="text" name="name" value="<%= profileUser.name %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <hr class="my-6 border-gray-200">

        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Ubah Password (Opsional)</h3>
        <p class="text-xs text-gray-500">Kosongkan bagian ini jika Anda tidak ingin mengganti password.</p>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Password Lama</label>
            <input type="password" name="current_password" placeholder="Masukkan password saat ini" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Password Baru</label>
                <input type="password" name="new_password" placeholder="Masukkan password baru" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Konfirmasi Password Baru</label>
                <input type="password" name="confirm_password" placeholder="Ulangi password baru" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
        </div>

        <div class="pt-4 flex justify-end">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition shadow-sm">
                Simpan Perubahan
            </button>
        </div>
    </form>
</div>

<!-- Script Alpine.js untuk menangani logika Preview Gambar -->
<script>
function profilePreview() {
    return {
        imageUrl: null,
        fileChosen(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    this.imageUrl = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }
    }
}
</script>