<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-4" x-data="profileForm()">
    <h2 class="text-xl font-bold text-gray-800 mb-1">Profil Saya</h2>
    <p class="text-sm text-gray-500 mb-6">Kelola informasi akun dan ubah password mandiri Anda di sini.</p>

    <form @submit.prevent="submitProfile" class="space-y-4">
        
        <div class="flex items-center space-x-4 my-4">
            
            <div class="relative group cursor-pointer flex-shrink-0 w-16 h-16 bg-blue-600 text-white rounded-full flex items-center justify-center text-xl font-bold overflow-hidden shadow-sm"
                 @click="showProfileModal = true" title="Klik untuk memperbesar foto">
                
                <template x-if="finalCroppedUrl">
                    <img :src="finalCroppedUrl" alt="Avatar Preview" class="w-full h-full object-cover">
                </template>
                <template x-if="!finalCroppedUrl">
                    <% if (profileUser.profile_picture) { %>
                        <img src="/uploads/profile/<%= profileUser.profile_picture %>?v=<%= Date.now() %>" alt="Avatar" class="w-full h-full object-cover">
                    <% } else { %>
                        <span><%= user.name.charAt(0).toUpperCase() %></span>
                    <% } %>
                </template>

                <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                </div>
            </div>

            <div class="flex-1 min-w-0">
                <label class="block text-xs font-semibold uppercase text-gray-500 mb-1">Ganti & Atur Foto Profil</label>
                
                <div class="flex flex-wrap items-center gap-2">
                    <input type="file" x-ref="fileInput" @change="fileChosen(event)" accept="image/jpeg, image/png, image/webp" class="text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 cursor-pointer">
                </div>
                <p class="text-[11px] text-gray-400 mt-1">Klik foto profil untuk memperbesar gambar. Format: JPG, PNG, WEBP (Maks. 2MB)</p>
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">NIP</label>
            <input type="text" value="<%= profileUser.nip %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Cabang</label>
                <input type="text" value="<%= profileUser.branch_name || '-' %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Unit Kerja</label>
                <input type="text" value="<%= profileUser.unit_name || '-' %>" disabled class="w-full px-3 py-2 border border-gray-200 bg-gray-100 rounded-lg text-sm text-gray-500 cursor-not-allowed">
            </div>
        </div>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Nama Lengkap</label>
            <input type="text" x-model="name" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <hr class="my-6 border-gray-200">

        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Ubah Password (Opsional)</h3>
        <p class="text-xs text-gray-500">Kosongkan bagian ini jika Anda tidak ingin mengganti password.</p>

        <div>
            <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Password Lama</label>
            <input type="password" x-model="current_password" name="current_password" placeholder="Masukkan password saat ini" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Password Baru</label>
                <input type="password" x-model="new_password" name="new_password" placeholder="Masukkan password baru" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Konfirmasi Password Baru</label>
                <input type="password" x-model="confirm_password" name="confirm_password" placeholder="Ulangi password baru" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            </div>
        </div>

        <div class="pt-4 flex justify-end">
            <button type="submit" :disabled="loading" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition shadow-sm flex items-center">
                <span x-show="loading" class="mr-2 animate-spin">⏳</span>
                <span x-text="loading ? 'Menyimpan...' : 'Simpan Perubahan'"></span>
            </button>
        </div>
    </form>

    <div x-show="showCropModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden transform transition-all">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-100 flex items-center justify-between">
                <h3 class="font-bold text-gray-800 text-base">Atur & Geser Posisi Foto</h3>
                <button type="button" @click="showCropModal = false" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>

            <div class="p-6">
                <p class="text-xs text-gray-500 mb-4">Geser atau zoom foto agar pas di dalam area lingkaran.</p>
                
                <div class="relative max-h-80 overflow-hidden flex justify-center items-center bg-gray-900 rounded-xl p-2">
                    <img id="cropperImageElement" class="max-w-full block" :src="tempImageUrl">
                </div>
            </div>

            <div class="px-6 py-3 bg-gray-50 border-t border-gray-100 flex justify-end space-x-3">
                <button type="button" @click="showCropModal = false" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold text-xs rounded-lg transition">Batal</button>
                <button type="button" @click="applyCrop()" class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-lg transition shadow-sm">Simpan Posisi</button>
            </div>
        </div>
    </div>


    <div x-show="showProfileModal" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-4" @click.self="showProfileModal = false">
        <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full overflow-hidden transform transition-all p-5 text-center">
            
            <div class="flex justify-between items-center mb-3">
                <h3 class="font-bold text-gray-800 text-sm">Foto Profil</h3>
                <button type="button" @click="showProfileModal = false" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
            </div>

            <div class="w-64 h-64 mx-auto rounded-xl overflow-hidden shadow-inner bg-gray-100 flex items-center justify-center border border-gray-100">
                <template x-if="finalCroppedUrl">
                    <img :src="finalCroppedUrl" alt="Foto Profil Besar" class="w-full h-full object-cover">
                </template>
                <template x-if="!finalCroppedUrl">
                    <% if (profileUser.profile_picture) { %>
                        <img src="/uploads/profile/<%= profileUser.profile_picture %>?v=<%= Date.now() %>" alt="Foto Profil Besar" class="w-full h-full object-cover">
                    <% } else { %>
                        <div class="w-full h-full bg-blue-600 text-white flex items-center justify-center text-5xl font-bold">
                            <%= user.name.charAt(0).toUpperCase() %>
                        </div>
                    <% } %>
                </template>
            </div>

            <div class="mt-5 space-y-2">
                <% if (profileUser.profile_picture || finalCroppedUrl) { %>
                    <a :href="finalCroppedUrl ? finalCroppedUrl : '/uploads/profile/<%= profileUser.profile_picture %>'" 
                       download="foto-profil-<%= profileUser.nip %>.jpg"
                       class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-xl transition flex items-center justify-center space-x-2 shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        <span>Download Foto</span>
                    </a>
                <% } %>

                <button type="button" @click="showProfileModal = false" class="w-full py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-xs rounded-xl transition">Tutup</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Membuat border crop box menjadi lingkaran (rounded-full) */
    .cropper-view-box, .cropper-face {
        border-radius: 50% !important;
    }
    .cropper-view-box {
        outline: 2px solid white !important;
        box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.6);
    }
</style>

<script>
function profileForm() {
    return {
        name: '<%= profileUser.name %>',
        current_password: '',
        new_password: '',
        confirm_password: '',
        tempImageUrl: null,
        finalCroppedUrl: null,
        croppedBlob: null,
        showCropModal: false,
        showProfileModal: false,
        cropper: null,
        loading: false,

        fileChosen(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    this.tempImageUrl = e.target.result;
                    // Buka modal otomatis setelah file dipilih supaya user bisa langsung atur posisi jika mau
                    this.openCropModal();
                };
                reader.readAsDataURL(file);
            }
        },

        openCropModal() {
            // Jika belum memilih file baru via input, jangan buka modal crop
            if (!this.tempImageUrl) {
                return; 
            }
            this.showCropModal = true;
            this.$nextTick(() => {
                const imageElement = document.getElementById('cropperImageElement');
                if (this.cropper) {
                    this.cropper.destroy();
                }
                this.cropper = new Cropper(imageElement, {
                    aspectRatio: 1,
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 0.9,
                    restore: false,
                    guides: false,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: false,
                    toggleDragModeOnDblclick: false,
                });
            });
        },

        applyCrop() {
            if (this.cropper) {
                this.finalCroppedUrl = this.cropper.getCroppedCanvas({
                    width: 400,
                    height: 400
                }).toDataURL('image/jpeg');

                this.cropper.getCroppedCanvas({
                    width: 400,
                    height: 400
                }).toBlob((blob) => {
                    this.croppedBlob = blob;
                }, 'image/jpeg', 0.9);

                this.showCropModal = false;
            }
        },

        async submitProfile(event) {
            this.loading = true;

            const formData = new FormData();
            formData.append('name', this.name);
            formData.append('current_password', this.current_password);
            formData.append('new_password', this.new_password);
            formData.append('confirm_password', this.confirm_password);

            if (this.croppedBlob) {
                formData.append('profile_picture', this.croppedBlob, 'profile.jpg');
            }

            try {
                const response = await fetch('/profile/update', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: result.message,
                        confirmButtonColor: '#2563eb'
                    });

                    const headerNameEl = document.getElementById('userNameDisplay');
                    if (headerNameEl) headerNameEl.innerText = this.name;

                    if (this.finalCroppedUrl) {
                        const headerAvatarContainer = document.querySelector('header .rounded-full.overflow-hidden');
                        if (headerAvatarContainer) {
                            headerAvatarContainer.innerHTML = `<img src="${this.finalCroppedUrl}" alt="Avatar" class="w-full h-full object-cover">`;
                        }
                    }

                    // ⭐ BERSIHKAN STATE CROP SETELAH BERHASIL DISIMPAN ⭐
                    this.tempImageUrl = null; 
                    if (this.cropper) {
                        this.cropper.destroy();
                        this.cropper = null;
                    }
                    this.croppedBlob = null;
                    this.$refs.fileInput.value = ''; // Reset input file HTML

                    this.current_password = '';
                    this.new_password = '';
                    this.confirm_password = '';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: result.message || 'Gagal memperbarui profil.',
                        confirmButtonColor: '#dc2626'
                    });
                }
            } catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Kesalahan Server',
                    text: 'Terjadi kesalahan pada koneksi server.',
                    confirmButtonColor: '#dc2626'
                });
            } finally {
                this.loading = false;
            }
        }
    }
}
</script>