<div class="space-y-6" x-data="{ search: '', openAddModal: false, unitType: 'yes', realParentId: '' }">
    <!-- Header Page & Kolom Pencarian -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Manajemen Unit</h1>
            <p class="text-sm text-gray-500 mt-1">Kelola Unit Manajemen dan unit operasional di bawahnya.</p>
        </div>
        
        <div class="flex items-center gap-3 w-full sm:w-auto">
            <!-- Kolom Input Search -->
            <div class="relative w-full sm:w-64">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </span>
                <input type="text" x-model="search" placeholder="Cari..." class="w-full pl-9 pr-4 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none shadow-sm">
            </div>

            <button @click="openAddModal = true" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition shadow-sm text-sm whitespace-nowrap">
                + Tambah Unit
            </button>
        </div>
    </div>

    <!-- Alert Notifikasi -->
    <% if (locals.success) { %>
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg text-sm"><%= success %></div>
    <% } %>
    <% if (locals.error) { %>
        <div class="p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm"><%= error %></div>
    <% } %>

    <!-- Tabel Data Unit dengan Support Responsive & Live Search -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="w-full overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[600px]">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                        <th class="px-6 py-4">Cabang</th>
                        <th class="px-6 py-4">Nama Unit</th>
                        <th class="px-6 py-4">Status / Naungan</th>
                        <th class="px-6 py-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 text-sm text-gray-700">
                    <% if (units.length === 0) { %>
                        <tr><td colspan="4" class="px-6 py-4 text-center text-gray-400">Belum ada data unit.</td></tr>
                    <% } else { %>
                        <% units.forEach(unit => { %>
                            <!-- Baris tabel difilter secara reaktif berdasarkan cabang atau nama unit -->
                            <tr class="hover:bg-gray-50 transition"
                                x-show="search === '' || [
                                    '<%= unit.branch_name %>', 
                                    '<%= unit.name %>', 
                                    '<%= unit.parent_name || 'Unit Manajemen' %>'
                                ].some(val => val.toLowerCase().includes(search.toLowerCase()))">
                                <td class="px-6 py-4 font-medium text-gray-600"><%= unit.branch_name %></td>
                                <td class="px-6 py-4 font-semibold text-gray-800"><%= unit.name %></td>
                                <td class="px-6 py-4">
                                    <% if (!unit.parent_unit_id) { %>
                                        <span class="px-2.5 py-1 text-xs font-semibold bg-purple-100 text-purple-700 rounded-full">Unit Manajemen (Atasan)</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 text-xs font-semibold bg-sky-100 text-sky-700 rounded-full">Sub Unit: <%= unit.parent_name %></span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <form action="/units/delete/<%= unit.id %>" method="POST" class="inline" onsubmit="return confirm('Yakin ingin menghapus unit ini?')">
                                        <button type="submit" class="text-red-600 hover:underline font-medium">Hapus</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Tambah Unit -->
    <div x-show="openAddModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4" style="display: none;">
        <div @click.away="openAddModal = false" class="bg-white rounded-xl shadow-xl w-full max-w-md p-6 space-y-4">
            <h3 class="text-lg font-bold text-gray-800">Tambah Unit Baru</h3>
            <form action="/units/create" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Pilih Cabang</label>
                    <select name="branch_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Cabang --</option>
                        <% branches.forEach(b => { %>
                            <option value="<%= b.id %>"><%= b.name %> (<%= b.branch_code %>)</option>
                        <% }) %>
                    </select>
                </div>

                <!-- Tipe Unit: Menggunakan string 'yes' dan 'no' -->
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Tipe Unit</label>
                    <select x-model="unitType" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="yes">Unit Manajemen (Contoh: Manager Pelayanan)</option>
                        <option value="no">Unit Biasa (Unit di bawah Manager)</option>
                    </select>
                </div>

                <!-- Input tersembunyi ini sekarang akan bekerja sempurna -->
                <input type="hidden" name="parent_unit_id" :value="unitType === 'yes' ? '' : realParentId">

                <!-- Pilihan Atasan hanya muncul jika unitType bernilai 'no' -->
                <div x-show="unitType === 'no'" style="display: none;">
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Masuk di Bawah Manager Apa?</label>
                    <select x-model="realParentId" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
                        <option value="">-- Pilih Manager / Unit Manajemen --</option>
                        <% managementUnits.forEach(mu => { %>
                            <option value="<%= mu.id %>"><%= mu.name %> (<%= mu.branch_name %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Nama Unit / Jabatan</label>
                    <input type="text" name="name" required placeholder="Contoh: Manager Pelayanan / Unit Loket" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                </div>

                <!-- Input Kode Unit hanya muncul jika unitType bernilai 'no' -->
                <div x-show="unitType === 'no'" style="display: none;">
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Kode Unit Singkat (Misal: LOKET, IT)</label>
                    <input type="text" name="unit_code" placeholder="LOKET" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                </div>

                <div class="flex justify-end space-x-2 pt-2">
                    <button type="button" @click="openAddModal = false" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-medium">Batal</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>