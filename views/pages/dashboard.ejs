<div class="space-y-6">
    <!-- Welcome Banner -->
    <div class="bg-blue-600 text-white p-6 rounded-2xl shadow-md">
        <h1 class="text-2xl font-bold">Selamat Datang Kembali, <%= user.name %>! 👋</h1>
        <p class="text-blue-100 text-sm mt-1">Sistem siap beroperasi. Anda masuk sebagai <strong class="uppercase"><%= user.role %></strong> di unit <%= user.unit_name || '-' %>.</p>
    </div>

    <!-- Dashboard Widget Grid Dinamis -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <p class="text-sm font-medium text-gray-500">Total Tiket Masuk</p>
            <h3 class="text-3xl font-bold text-gray-800 mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <p class="text-sm font-medium text-gray-500">Tiket Open / Pending</p>
            <h3 class="text-3xl font-bold text-amber-600 mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <p class="text-sm font-medium text-gray-500">Sedang Dikerjakan (In-Progress)</p>
            <h3 class="text-3xl font-bold text-blue-600 mt-2">0</h3>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <p class="text-sm font-medium text-gray-500">Tiket Selesai (Resolved)</p>
            <h3 class="text-3xl font-bold text-emerald-600 mt-2">0</h3>
        </div>
    </div>
</div>