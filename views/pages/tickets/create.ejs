<div class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8" x-data="ticketForm()">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
        
        <!-- Header Halaman -->
        <div class="mb-8 border-b border-gray-100 pb-4">
            <h1 class="text-2xl font-bold text-gray-800">Buat Tiket Baru</h1>
            <p class="text-sm text-gray-500 mt-1">Laporkan kendala operasional Anda untuk segera ditindaklanjuti oleh unit terkait.</p>
        </div>

        <form action="/tickets/create" method="POST" enctype="multipart/form-data" class="space-y-6" id="ticketFormElement">
            
            <!-- Pencarian Cepat Global -->
            <div class="relative bg-blue-50/50 p-4 rounded-xl border border-blue-100" @click.away="openQuickSearch = false">
                <label class="block text-xs font-semibold uppercase text-blue-800 mb-1">Pencarian Cepat Kendala (Opsional)</label>
                <p class="text-xs text-gray-500 mb-2">Ketik kata kunci untuk memilih kategori & detail secara instan.</p>
                <div class="relative">
                    <input type="text" 
                           x-model="quickQuery" 
                           @focus="openQuickSearch = true"
                           @input="openQuickSearch = true"
                           placeholder="Cepat cari kendala (misal: internet, lambat, printer)..." 
                           class="w-full px-4 py-2.5 pl-9 border border-blue-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none transition shadow-sm">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-blue-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                </div>

                <!-- Dropdown Hasil Pencarian Cepat -->
                <div x-show="openQuickSearch && quickResults.length > 0" x-cloak 
                     class="absolute z-50 w-full left-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-xl max-h-60 overflow-y-auto divide-y divide-gray-100">
                    <template x-for="(item, index) in quickResults" :key="index">
                        <div @click="selectQuickItem(item)" 
                             class="px-4 py-2.5 hover:bg-blue-50 cursor-pointer transition text-sm">
                            <div class="font-semibold text-blue-600 text-xs" x-text="item.category"></div>
                            <div class="text-gray-700 font-medium text-xs mt-0.5" x-text="item.issue_description"></div>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Baris 1: Kategori & Deskripsi Kendala -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Kategori Kendala <span class="text-red-500">*</span></label>
                    <select id="select-category" name="category" required class="w-full">
                        <option value="">-- Pilih Kategori --</option>
                        <% 
                            const uniqueCats = [...new Set(ticketCategories.map(item => item.category))];
                            uniqueCats.forEach(cat => { 
                        %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                </div>
                
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Deskripsi Kendala <span class="text-red-500">*</span></label>
                    <select id="select-issue" name="issue_description" required class="w-full">
                        <option value="">-- Pilih Detail Kendala --</option>
                    </select>
                </div>
            </div>

            <!-- Baris 2: Unit Tujuan & Prioritas -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Unit Tujuan <span class="text-red-500">*</span></label>
                    <select id="select-unit" name="target_unit_id" required class="w-full">
                        <option value="">-- Pilih Unit yang Dituju --</option>
                        <% units.forEach(unit => { %>
                            <option value="<%= unit.id %>"><%= unit.name %> (<%= unit.branch_name %>)</option>
                        <% }) %>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Prioritas <span class="text-red-500">*</span></label>
                    <select id="select-priority" name="priority" required class="w-full">
                        <option value="Low">Low (Bisa ditunda)</option>
                        <option value="Medium" selected>Medium (Normal)</option>
                        <option value="High">High (Penting, butuh cepat)</option>
                        <option value="Urgent">Urgent (Kritis, sistem lumpuh)</option>
                    </select>
                </div>
            </div>

            <!-- Baris 3: Detail Kendala (Textarea) -->
            <div>
                <label class="block text-xs font-semibold uppercase text-gray-600 mb-2">Detail Kendala / Pesan Lengkap <span class="text-red-500">*</span></label>
                <textarea name="details" required rows="5" placeholder="Jelaskan terkait kendala yang dialami secara lengkap..." class="w-full px-4 py-3 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none transition"></textarea>
            </div>

            <!-- Baris 4: Lampiran -->
            <div x-data="{ previewUrl: null, fileName: '', openModal: false }" class="space-y-4">
                <label class="block text-xs font-semibold uppercase text-gray-600">Lampiran / Foto Kendala (Opsional)</label>
                
                <!-- Kotak Upload Unik yang Fleksibel -->
                <div class="p-5 border-2 border-dashed border-gray-300 hover:border-blue-500 rounded-2xl bg-gray-50/50 transition flex flex-col items-center justify-center text-center relative group">
                    
                    <!-- Kondisi Belum Ada File -->
                    <template x-if="!previewUrl">
                        <div class="space-y-3 py-2 w-full">
                            <div class="flex justify-center items-center space-x-2 text-gray-400">
                                <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            </div>
                            <div>
                                <p class="text-xs font-bold text-gray-700">Lampirkan Foto atau Dokumen</p>
                                <p class="text-[11px] text-gray-400 mt-0.5">Pilih file dari galeri atau ambil foto langsung menggunakan kamera perangkat.</p>
                            </div>
                            
                            <!-- Tombol Aksi Berdampingan -->
                            <div class="flex flex-wrap justify-center gap-2 pt-2">
                                <!-- Tombol Galeri -->
                                <label class="inline-flex items-center px-3.5 py-2 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 rounded-xl text-xs font-semibold cursor-pointer shadow-sm transition">
                                    <svg class="w-4 h-4 mr-1.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                    <span>📁 Pilih Galeri</span>
                                    <input type="file" name="attachment" accept="image/*,.pdf" class="hidden"
                                           @change="if($event.target.files[0]) { fileName = $event.target.files[0].name; previewUrl = URL.createObjectURL($event.target.files[0]); }">
                                </label>

                                <!-- Tombol Kamera Langsung -->
                                <label class="inline-flex items-center px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-semibold cursor-pointer shadow-sm transition">
                                    <svg class="w-4 h-4 mr-1.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    <span>📸 Buka Kamera</span>
                                    <input type="file" name="attachment" accept="image/*" capture="environment" class="hidden"
                                           @change="if($event.target.files[0]) { fileName = $event.target.files[0].name; previewUrl = URL.createObjectURL($event.target.files[0]); }">
                                </label>
                            </div>
                        </div>
                    </template>

                    <!-- Kondisi Jika File Sudah Dipilih/Direkam -->
                    <template x-if="previewUrl">
                        <div class="flex items-center justify-between w-full py-1 px-2">
                            <div class="flex items-center space-x-3">
                                <div class="relative w-16 h-16 border border-gray-200 rounded-xl overflow-hidden shadow-sm cursor-pointer group" @click="openModal = true">
                                    <img :src="previewUrl" class="w-full h-full object-cover group-hover:scale-105 transition duration-200">
                                    <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-[9px] font-semibold">
                                        🔍 Zoom
                                    </div>
                                </div>
                                <div class="text-left">
                                    <p class="text-xs font-bold text-gray-800 truncate max-w-xs" x-text="fileName"></p>
                                    <p class="text-[10px] text-green-600 font-medium mt-0.5">✔ File siap dilampirkan</p>
                                </div>
                            </div>

                            <button type="button" @click="previewUrl = null; fileName = ''; $el.closest('form').querySelectorAll('input[type=file]').forEach(i => i.value = '')" 
                                    class="px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-xl text-xs font-semibold transition flex items-center shadow-sm">
                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                Ganti / Hapus
                            </button>
                        </div>
                    </template>
                </div>

                <p class="text-xs text-gray-400">Maksimal 2MB. Format: JPG, PNG, atau PDF (File otomatis dinamai sesuai nomor tiket).</p>

                <!-- MODAL POPUP PREVIEW FULL-SCREEN -->
                <div x-show="openModal" x-cloak 
                     class="fixed inset-0 z-50 bg-gray-950/80 backdrop-blur-sm flex items-center justify-center p-4"
                     @click.self="openModal = false">
                    <div class="relative bg-white rounded-3xl shadow-2xl max-w-3xl w-full p-4 overflow-hidden border border-gray-100">
                        <!-- Header Modal -->
                        <div class="flex items-center justify-between pb-3 border-b border-gray-100 mb-3">
                            <h3 class="text-sm font-bold text-gray-800">Pratinjau Foto Lampiran</h3>
                            <button type="button" @click="openModal = false" class="p-1.5 text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                        
                        <!-- Gambar Full Size -->
                        <div class="flex justify-center bg-gray-50 rounded-2xl p-2 max-h-[75vh] overflow-auto">
                            <img :src="previewUrl" class="max-w-full max-h-[70vh] object-contain rounded-xl shadow-sm">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end space-x-3">
                <a href="/dashboard" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-sm font-semibold transition">Batal</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg text-sm shadow-sm transition">
                    Buat Ticket
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Script Sinkronisasi Tom Select & Alpine.js -->
<script>
function ticketForm() {
    return {
        categoriesData: <%- JSON.stringify(ticketCategories || []) %>, 
        quickQuery: '',
        openQuickSearch: false,
        openModal: false,
        fileName: '',
        previewUrl: null,
        categoryControl: null,
        issueControl: null,

        get quickResults() {
            if (!this.quickQuery || this.quickQuery.trim() === '') return [];
            const query = this.quickQuery.toLowerCase();
            return this.categoriesData.filter(item => 
                item.category.toLowerCase().includes(query) || 
                item.issue_description.toLowerCase().includes(query)
            );
        },

        selectQuickItem(item) {
            this.categoryControl.setValue(item.category);
            this.updateIssueOptions(item.category);
            this.issueControl.setValue(item.issue_description);
            
            // Kosongkan kotak pencarian cepat setelah dipilih
            this.quickQuery = '';
            this.openQuickSearch = false;
        },

        init() {
            // 1. Inisialisasi Tom Select Kategori
            this.categoryControl = new TomSelect("#select-category", {
                create: false,
                sortField: {field: "text", direction: "asc"},
                onChange: (value) => {
                    this.updateIssueOptions(value);
                }
            });

            // 2. Inisialisasi Tom Select Deskripsi Kendala
            this.issueControl = new TomSelect("#select-issue", {
                create: false,
                sortField: {field: "text", direction: "asc"}
            });

            // Nonaktifkan detail kendala di awal
            this.issueControl.disable();

            // 3. Inisialisasi Tom Select Unit & Prioritas
            new TomSelect("#select-unit", { create: false, sortField: {field: "text", direction: "asc"} });
            new TomSelect("#select-priority", { create: false });
        },

        updateIssueOptions(category) {
            this.issueControl.clear();
            this.issueControl.clearOptions();

            if (!category) {
                this.issueControl.disable();
                return;
            }

            this.issueControl.enable();
            
            const issues = this.categoriesData
                .filter(item => item.category === category)
                .map(item => item.issue_description);
            
            const uniqueIssues = [...new Set(issues)];
            
            uniqueIssues.forEach(issue => {
                this.issueControl.addOption({ value: issue, text: issue });
            });
            this.issueControl.refreshOptions(false);
        }
    }
}
</script>