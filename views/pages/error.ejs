<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akses Ditolak - Ticketing App</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md text-center">
        <h1 class="text-3xl font-bold text-red-600 mb-2">403</h1>
        <p class="text-lg font-semibold text-gray-800 mb-4">Akses Ditolak</p>
        <p class="text-sm text-gray-500 mb-6"><%= message %></p>
        <a href="/dashboard" class="inline-block bg-blue-600 text-white font-bold py-2 px-6 rounded-lg hover:bg-blue-700 transition">
            Kembali ke Dashboard
        </a>
    </div>
</body>
</html>