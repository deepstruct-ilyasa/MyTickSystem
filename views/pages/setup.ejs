<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Wizard - Enterprise Ticketing System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full bg-gradient-to-tr from-slate-950 via-slate-900 to-blue-950 flex items-center justify-center p-4 sm:p-6 lg:p-8 font-sans antialiased">

    <!-- Background Glow Effect -->
    <div class="fixed w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none -top-20 -left-20"></div>
    <div class="fixed w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none -bottom-20 -right-20"></div>

    <div class="relative w-full max-w-xl bg-white/[0.98] backdrop-blur-2xl rounded-3xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.5)] border border-white/40 overflow-hidden my-auto">
        
        <!-- Header Section -->
        <div class="pt-8 pb-6 px-6 sm:px-12 text-center bg-gradient-to-b from-gray-50/80 to-transparent border-b border-gray-100">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-500/30 mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-gray-900">Inisialisasi Sistem</h1>
            <p class="text-gray-500 text-xs sm:text-sm mt-1">Langkah awal konfigurasi profil perusahaan dan akun administrator utama.</p>
        </div>

        <!-- Form Section -->
        <form action="/setup" method="POST" class="p-6 sm:p-10 space-y-6">
            
            <!-- Group 1: Perusahaan -->
            <div class="space-y-3">
                <div class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Identitas Organisasi</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1.5">Nama Perusahaan / Instansi</label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-blue-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        </span>
                        <input type="text" name="company_name" required placeholder="Contoh: PT. Ilyasa Corporation" 
                            class="w-full pl-12 pr-4 py-3 bg-gray-50/70 border border-gray-200/80 rounded-2xl text-sm font-medium text-gray-900 focus:bg-white focus:ring-4 focus:ring-blue-500/10 focus:border-blue-600 focus:outline-none transition-all">
                    </div>
                </div>
            </div>

            <!-- Group 2: Superadmin -->
            <div class="space-y-3">
                <div class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-indigo-600"></span>
                    <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Kredensial Superadmin</h2>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1.5">Nama Lengkap Administrator</label>
                    <div class="relative group">
                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-indigo-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </span>
                        <input type="text" name="admin_name" required placeholder="Administrator System" 
                            class="w-full pl-12 pr-4 py-3 bg-gray-50/70 border border-gray-200/80 rounded-2xl text-sm font-medium text-gray-900 focus:bg-white focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-600 focus:outline-none transition-all">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1.5">NIP / ID Karyawan</label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-indigo-600 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2a2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                            </span>
                            <input type="text" name="admin_nip" required autocomplete="username" placeholder="000000"
                                class="w-full pl-12 pr-4 py-3 bg-gray-50/70 border border-gray-200/80 rounded-2xl text-sm font-medium text-gray-900 focus:bg-white focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-600 focus:outline-none transition-all">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1.5">Kata Sandi Utama</label>
                        <div class="relative group">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 group-focus-within:text-indigo-600 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            </span>
                            <input type="password" name="admin_password" required autocomplete="current-password" placeholder="••••••••"
                                class="w-full pl-12 pr-4 py-3 bg-gray-50/70 border border-gray-200/80 rounded-2xl text-sm font-medium text-gray-900 focus:bg-white focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-600 focus:outline-none transition-all">
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" 
                class="w-full mt-2 bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-xl shadow-blue-600/20 hover:shadow-blue-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 flex items-center justify-center space-x-3 text-sm tracking-wide">
                <span>Selesaikan Setup & Simpan</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
        </form>

        <!-- Footer -->
        <div class="bg-gray-50/50 py-3.5 px-6 border-t border-gray-100 text-center">
            <p class="text-xs text-gray-400 font-medium">Enterprise Ticketing System &bull; Secured Setup Environment</p>
        </div>

    </div>

</body>
</html>