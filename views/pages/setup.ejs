<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Setup Wizard - Ticketing App</title>
    <!-- Tailwind CDN untuk development cepat -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">

    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-800">Setup Sistem</h1>
            <p class="text-sm text-gray-500 mt-2">Sistem mendeteksi database masih kosong. Silakan inisialisasi perusahaan dan akun Superadmin.</p>
        </div>

        <form action="/setup" method="POST" class="space-y-5">
            <!-- Data Perusahaan -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nama Perusahaan</label>
                <input type="text" name="company_name" required placeholder="PT. Inovasi Teknologi" 
                    class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
            </div>

            <hr class="border-gray-200">

            <!-- Data Superadmin -->
            <div>
                <label class="block text-sm font-medium text-gray-700">Nama Lengkap (Superadmin)</label>
                <input type="text" name="admin_name" required placeholder="Nama Anda" 
                    class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">NIP / ID Karyawan</label>
                <input type="text" name="admin_nip" required placeholder="NIP12345" 
                    class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700">Password</label>
                <input type="password" name="admin_password" required placeholder="••••••••" 
                    class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500">
            </div>

            <button type="submit" 
                class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-lg hover:bg-blue-700 transition duration-300">
                Selesaikan Setup & Simpan
            </button>
        </form>
    </div>

</body>
</html>