<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'MyTickSystem' %></title>

    <link rel="icon" type="image/png" href="/logo.png">
    <link href="/css/output.css" rel="stylesheet">
    <link href="/vendor/tom-select/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link href="/vendor/cropperjs/cropper.min.css" rel="stylesheet">
    
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-gray-50 font-sans antialiased">

    <div class="flex h-screen overflow-hidden" x-data="{ sidebarOpen: false }">
        <%- include('../partials/sidebar') %>
        <div class="flex flex-col flex-1 h-full overflow-hidden">
            <%- include('../partials/header') %>
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-6">
                <%- include(partialsPath) %>
            </main>
        </div>
    </div>

    <script src="/vendor/tom-select/tom-select.complete.min.js"></script>
    <script src="/vendor/chart.umd.min.js"></script>
    <script src="/vendor/cropperjs/cropper.min.js"></script>
    <script defer src="/vendor/alpine.min.js"></script>
    <script src="/vendor/sweetalert2.all.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const successMsg = urlParams.get('success');
            const errorMsg = urlParams.get('error');

            if (successMsg) {
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: successMsg,
                    confirmButtonColor: '#2563eb'
                }).then(() => {
                    window.history.replaceState({}, document.title, window.location.pathname);
                });
                window.history.replaceState({}, document.title, window.location.pathname);

            } else if (errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: errorMsg,
                    confirmButtonColor: '#dc2626'
                }).then(() => {
                    window.history.replaceState({}, document.title, window.location.pathname);
                });
                window.history.replaceState({}, document.title, window.location.pathname);
            }

            // ==========================================
            // ⭐ MASTER GLOBAL POLLING (SYNC SERENTAK) ⭐
            // ==========================================
            const SYNC_INTERVAL = 5000;

            setInterval(() => {
                if (typeof window.checkGlobalNotifications === 'function') {
                    window.checkGlobalNotifications();
                }
                if (typeof window.fetchAndUpdateDashboard === 'function') {
                    window.fetchAndUpdateDashboard();
                }
                if (typeof window.fetchAndUpdateTickets === 'function') {
                    window.fetchAndUpdateTickets();
                }
            }, SYNC_INTERVAL);
        });
    </script>
</body>
</html>