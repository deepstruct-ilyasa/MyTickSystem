<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Ticketing System' %></title>
    
    <!-- Tailwind CSS Lokal (Hasil Kompilasi CLI) -->
    <link href="/css/output.css" rel="stylesheet">
    
    <!-- Alpine.js Lokal -->
    <script defer src="/vendor/alpine.min.js"></script>
    
    <!-- Tom Select CSS Lokal -->
    <link href="/vendor/tom-select/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
        
    <!-- SweetAlert2 Lokal -->
    <script src="/vendor/sweetalert2.all.min.js"></script>
    
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="bg-gray-50 font-sans antialiased">

    <div class="flex h-screen overflow-hidden" x-data="{ sidebarOpen: false }">
        
        <!-- Sidebar Component -->
        <%- include('../partials/sidebar') %>

        <!-- Main Content Area -->
        <div class="flex flex-col flex-1 h-full overflow-hidden">
            
            <!-- Header Component -->
            <%- include('../partials/header') %>

            <!-- Dynamic Content Page -->
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-6">
                <%- include(partialsPath) %>
            </main>
        </div>
    </div>

    <!-- Tom Select & Chart.js Lokal -->
    <script src="/vendor/tom-select/tom-select.complete.min.js"></script>
    <script src="/vendor/chart.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <!-- Global SweetAlert2 Notification & URL Cleaner Handler -->
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const successMsg = urlParams.get('success');
        const errorMsg = urlParams.get('error');

        if (successMsg) {
            Swal.fire({
                icon: 'success',
                title: 'Berhasil!',
                text: successMsg,
                confirmButtonColor: '#2563eb'
            }).then(() => {
                window.history.replaceState({}, document.title, window.location.pathname);
            });
            window.history.replaceState({}, document.title, window.location.pathname);

        } else if (errorMsg) {
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: errorMsg,
                confirmButtonColor: '#dc2626'
            }).then(() => {
                window.history.replaceState({}, document.title, window.location.pathname);
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
    </script>
</body>
</html>